# VNX runtime artifacts (local only) — strategic docs moved to claudedocs/ (OI-1373 Tiers 1-5)
.vnx-data/*
.vnx-data/state/*
state/
state_archive_*/
state_archive/
t0_receipts.ndjson
logs/
pids/
locks/
dispatches/
!demo/dry-run/evidence/dispatches/
unified_reports/
receipts/
queue/
reports/
!demo/dry-run/evidence/reports/
!dashboard/token-dashboard/app/operator/reports/
orchestration/

# Database runtime files (generated locally by init scripts)
database/*.db
ledger/storage/*.db

# Benchmark field-tests: generated seed DBs (rebuilt per run)
scripts/benchmark/field-tests/tasks/**/seed/*.db
scripts/benchmark/field-tests/tasks/**/seed/*.db.stale

# Archive and backup directories (not part of current system)
archive/
backup_*/
docs/archive/

# Internal docs (not for public repo — all internal docs go in docs/internal/)
docs/internal/
docs/roadmap/
docs/architecture/

# Old versioned scripts (superseded)
scripts/claude_auth_check.sh
scripts/userpromptsubmit_intelligence_inject.sh

# Scripts runtime state
scripts/state/
scripts/.pr_state.json
scripts/PR_QUEUE.md

# Temp/one-off scripts
fix_git_history.sh

# Root-level runtime files
index.html
!dashboard/index.html

# Runtime PID files
*.pid

# Claude Code runtime lock files
.claude/scheduled_tasks.lock

# Claude Code local overrides (per-maintainer, never published)
CLAUDE.local.md
.claude/settings.local.json

# Local runtime logs
scripts/*.log
scripts/smart_tap.log

# Python runtime artifacts
__pycache__/
*.pyc

# Python packaging build artifacts (never commit)
dist/
build/
*.egg-info/

# Virtual environments
.venv/
venv/

# Scratch/advisory docs (generated, not part of source)
CHANGELOG_QUALITY_ADVISORY.md

# PR queue runtime artifacts (do not commit)
/.pr_state.json
/PR_QUEUE.md

# Old config directory (merged into configs/) — root-anchored so it does not match
# nested app routes like dashboard/token-dashboard/app/operator/config/
/config/

# Old testing directory (merged into tests/)
testing/

# Private per-project prep migrations — never publish
schemas/prep_migrations/

# Environment files
.env
.env.*
# ...but benchmark task seed .env fixtures ARE tracked (dummy placeholders only) so a
# clean worktree checkout materializes them. Without this the seed .env is absent in the
# worker worktree → verify.py crashes (infra-fail, not a model capability fail).
!scripts/benchmark/field-tests/tasks/**/seed/.env

# VNX provider secrets
vnx.env
.vnx/vnx.env

# macOS
.DS_Store

# Test result artifacts
tests/*.log
tests/*_RESULTS.md
tests/*_ISSUE.md

# Project-specific integration tests (not part of generic VNX)
tests/test_carina_*.py
claudedocs/
.vnx-intelligence/
*.tsbuildinfo

# t6 real-codebase-review tier — INTERNAL ONLY (reviews proprietary repos; never publish)
scripts/benchmark/field-tests/tasks/t6_real_review/
scripts/benchmark/field-tests/tasks.local.yaml

# Install-artifacts: gegenereerd door `vnx init` / `vnx role sync` / bootstrap_hooks.
# Alleen de authored bron hoort in git (.claude/skills/*/SKILL.md,
# .claude/terminals/*/CLAUDE.md, role-orchestrator.md). De scaffolding eromheen
# wordt per machine opnieuw uitgerold en gaf vijf dagen lang git-status-ruis.
.claude/skills/*/references/
.claude/skills/*/scripts/
.claude/skills/*/template.md
.claude/skills/*/@*.md
.claude/skills/skills.yaml
.claude/hooks/
.claude/terminals/*/.claude
.claude/terminals/*/.mcp.json
.claude/vnx-system/security_reports/
.agents/
.vnx-attest/
.vnx/config.yml

# Tri-file rolbestanden (AGENTS.md / GEMINI.md): gegenereerde mirrors van de
# canonieke rol, niet met de hand geschreven. `vnx role sync --apply` spiegelt
# de rol naar .claude/terminals/T0/ (Codex/Gemini/Kimi-orchestrator); de
# repo-root-versies schrijft patch-agent-files. Alleen de authored bron
# (role-orchestrator.md) hoort in git — een verse sync mag de git-status niet
# vervuilen (OI-1228: merge_preflight Check 1 blokkeert dan op untracked files).
/AGENTS.md
/GEMINI.md
.claude/terminals/T0/AGENTS.md
.claude/terminals/T0/GEMINI.md

# Generated feature-plan snapshot: FEATURE_PLAN.md is regenerated by
# scripts/build_feature_plan.py as a side effect of routine dispatch/reconcile
# runs (build_t0_state.py, pr_queue_manager.py, closure_verifier.py, and other
# state-sync scripts write it too). Tracking it turned every worktree dirty on
# a plain regenerate, and complete work got scored as a failure by the dirty
# check (OI-1376). The artifact stays on disk — only the git tracking is gone.
/FEATURE_PLAN.md

# Sessie-logs: eigen inhoud, maar met dagbedragen aan AI-kosten en klantcontext.
# Deze repo is publiek, dus die gaan er niet in. Backup staat buiten git in de
# centrale per-project store: ~/.vnx-data/<project>/daily-log/
daily-log/
