%% Verified against origin/main at c41411fea on 2026-11-12. Dashed edges are opt-in or default-off.
graph TD
    subgraph PLAN["Planning (tracks DB, vnx horizon)"]
        TRACKS[Tracks and deliverables]
        PG{Plan gate: one seat, a second on BLOCK}
    end

    subgraph CTRL["Control plane"]
        T0[T0 orchestrator role - interactive session]
        HUMAN{Human: stage, dry-run, fire}
    end

    subgraph DOOR["Single-entry door: vnx dispatch"]
        PLANX[Compiled plan and permit]
        LANE{Lane by provider}
        HEAD[claude_headless: claude -p, own worktree]
        PROV[provider_dispatch: kimi, glm, deepseek]
    end

    subgraph REVIEW["Review and merge"]
        SEATS[Review seats: codex_gate, kimi_gate]
        TAKE[Takeover: deepseek_gate]
        MERGE{pr_merge.py preflights: ci, review, adr, contract_invalid, branch_protection, door}
    end

    subgraph LEDGER["Audit layer"]
        REPORT[Unified report per dispatch]
        RECEIPTS[(t0_receipts.ndjson, append-only)]
        STORE[(Per-project store and runtime DB)]
    end

    subgraph LEARN["Learning (proposals only)"]
        INJECT[Intelligence injection into the dispatch]
        LOOP[Learning loop: shadow, queue]
        DREAM[Dream consolidation]
        STEER[Operator steering proposals]
        OPERATOR{Operator decides}
    end

    TRACKS --> PG --> T0
    T0 -->|stage| HUMAN
    HUMAN -->|fire| PLANX --> LANE
    LANE --> HEAD
    LANE --> PROV
    INJECT --> PLANX
    HEAD --> REPORT
    PROV --> REPORT
    REPORT -->|receipt processor| RECEIPTS
    RECEIPTS --> STORE
    HEAD -->|PR| SEATS
    PROV -->|PR| SEATS
    SEATS -.->|reviewer out| TAKE
    SEATS --> MERGE
    TAKE --> MERGE
    RECEIPTS --> LOOP
    RECEIPTS -.-> DREAM
    STEER -.-> OPERATOR
    LOOP --> OPERATOR
    DREAM -.-> OPERATOR
    OPERATOR -->|approved rule| INJECT
    STORE --> T0

    style RECEIPTS fill:#f96,stroke:#333,stroke-width:2px
    style HUMAN fill:#bbf,stroke:#333,stroke-width:2px
    style OPERATOR fill:#bbf,stroke:#333,stroke-width:2px
    style MERGE fill:#bbf,stroke:#333,stroke-width:2px
