<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.vnx.door-audit</string>
  <!--
    Deur D7b: ONE machine-wide daily job (no project id in the Label, not a per-project
    family). It runs the all-projects mode of backfill_pr_merged_receipts.py: one
    subprocess per project over the union of ~/.vnx/projects.json and the installed
    ledger-health labels. Exit 1 = a merge without receipt, 2 = a project unmeasurable;
    the job records and never gates a build. Daily 06:30; each project's beacon
    health/door_audit.json expects a write every 2 days. Installing is an operator step:
      bash scripts/launchd/reload_plist.sh com.vnx.door-audit
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>cd ${VNX_HOME} &amp;&amp; PY=$(bash ${VNX_HOME}/scripts/launchd/vnx_python.sh ${VNX_HOME}) || exit 78; exec "$PY" scripts/backfill_pr_merged_receipts.py --all-projects</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>StandardOutPath</key><string>/tmp/vnx-door-audit.log</string>
  <key>StandardErrorPath</key><string>/tmp/vnx-door-audit.err</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>VNX_HOME</key>
    <string>${VNX_HOME}</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
