{
 "event": "PreToolUse",
 "payload": {
  "session_id": "<session_id>",
  "transcript_path": "<home>/.claude/projects/<project>/<session_id>.jsonl",
  "cwd": "<project_dir>",
  "scratchpad_dir": "<scratchpad_dir>",
  "prompt_id": "<prompt_id>",
  "permission_mode": "auto",
  "effort": {
   "level": "medium"
  },
  "hook_event_name": "PreToolUse",
  "tool_name": "Agent",
  "tool_input": {
   "description": "Run ls and report",
   "prompt": "Run `ls` with the Bash tool in the current working directory and report the exact output.",
   "subagent_type": "general-purpose"
  },
  "tool_use_id": "<tool_use_id>"
 },
 "env_present": [
  "CLAUDECODE",
  "CLAUDE_CODE_CHILD_SESSION",
  "CLAUDE_CODE_ENTRYPOINT",
  "CLAUDE_CODE_MESSAGING_SOCKET",
  "CLAUDE_CODE_MESSAGING_TOKEN",
  "CLAUDE_CODE_SESSION_ATTENDED",
  "CLAUDE_CODE_SESSION_ID",
  "CLAUDE_EFFORT",
  "CLAUDE_PID",
  "CLAUDE_PLUGIN_DATA",
  "CLAUDE_PLUGIN_ROOT",
  "CLAUDE_PROJECT_DIR",
  "TMUX",
  "TMUX_PANE",
  "TMUX_PLUGIN_MANAGER_PATH",
  "TMUX_TMPDIR"
 ],
 "env_values": {
  "CLAUDE_PID": "<pid>",
  "CLAUDE_CODE_SESSION_ID": "<session_id>",
  "TMUX_PANE": "%<n>",
  "CLAUDE_CODE_ENTRYPOINT": "cli",
  "CLAUDECODE": "1"
 },
 "ancestry": [
  "<pid> <ppid> <lstart> python3",
  "<pid> <ppid> <lstart> sh",
  "<pid> <ppid> <lstart> claude",
  "<pid> <ppid> <lstart> -zsh",
  "<pid> <ppid> <lstart> tmux"
 ]
}
